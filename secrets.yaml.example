# SnapStream tenant API credentials for one instance.
# Copy to secrets.yaml (gitignored) and fill in the values from
# Cloud Admin > instance > Modify > API (shown after Provision API).
# Never commit secrets.yaml and never paste these values into chat, Slack or email.

instance: demo.cloud.snapstream.com   # server513, label only
base_url: "https://REPLACE_ME"        # "Base URL" on the Provision API screen
token_endpoint: "https://REPLACE_ME"  # Cognito token endpoint
client_id: "REPLACE_ME"
client_secret: "REPLACE_ME"
api_key: "REPLACE_ME"                 # sent as the x-api-key header
scopes: "REPLACE_ME"                  # space-separated, if the screen lists any; else leave empty
